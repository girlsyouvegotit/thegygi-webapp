NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5173
# Comma-separated extra origins for HTTP + Socket.IO CORS (optional)
# SOCKET_CORS_ORIGIN=https://gygingo.vercel.app,https://girlsyougotit.org
MONGO_URL=

# Use a long random string in production (≥32 chars recommended)
JWT_SECRET=your_jwt_secret_key

GOOGLE_GENERATIVE_AI_API_KEY=

# Uploads / class recordings (required on Render — local disk is ephemeral)
UPLOADTHING_TOKEN=

# Email (required for password reset in production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_SECURE=false

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@gygi.org

# Inngest (optional scheduled jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
